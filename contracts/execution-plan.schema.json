{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timed-mission-agent.local/contracts/execution-plan.schema.json",
  "title": "Execution Plan",
  "type": "object",
  "required": ["schema_version", "mission_id", "class", "steps", "fingerprint"],
  "properties": {
    "schema_version": {"const": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "class": {"enum": ["deterministic", "document", "browser", "research", "composite"]},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "task_kind",
          "depends_on",
          "capability_kind",
          "replay_safe",
          "budget_cost_microunits",
          "budget_latency_ms"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "task_kind": {
            "enum": ["transform", "extract_document", "browser_action", "research", "reason", "validate"]
          },
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "capability_kind": {
            "enum": ["native", "api", "mcp", "browser", "computer", "vision", "document", "research", "llm", "storage", "notification"]
          },
          "replay_safe": {"type": "boolean"},
          "budget_cost_microunits": {"type": "integer", "minimum": 0},
          "budget_latency_ms": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
