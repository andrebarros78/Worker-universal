{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timed-mission-agent.local/contracts/recovery-decision.schema.json",
  "title": "Recovery Decision",
  "type": "object",
  "required": [
    "schema_version",
    "error_class",
    "disposition",
    "action",
    "attempt",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "error_class": {
      "enum": [
        "network_failure",
        "session_expired",
        "element_moved",
        "layout_changed",
        "rate_limit",
        "worker_crash",
        "model_timeout",
        "low_confidence",
        "validation_failed",
        "duplicate_risk",
        "deadline_risk",
        "external_dependency",
        "permission_denied",
        "contract_mismatch",
        "cancelled",
        "unknown"
      ]
    },
    "disposition": {"enum": ["retry","needs_review","terminal_failed","terminal_deadline","cancelled"]},
    "action": {
      "enum": [
        "retry_same","refresh_session","relocate_element","reobserve_replan","backoff",
        "restart_worker","try_fallback","selective_reread","reexecute_validate",
        "independent_review","deadline_exceeded","wait_external","permission_review",
        "replan_contract","cancel_terminal","manual_review"
      ]
    },
    "attempt": {"type": "integer", "minimum": 0},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  },
  "additionalProperties": false
}
