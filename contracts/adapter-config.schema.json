{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://timed-mission-agent.local/contracts/adapter-config.schema.json",
  "title":"Adapter Configuration Reference",
  "type":"object",
  "required":["schema_version","adapter_id","config_version","settings","secret_refs"],
  "properties":{
    "schema_version":{"const":1},
    "adapter_id":{"type":"string","minLength":1},
    "config_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "settings":{"type":"object"},
    "secret_refs":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":false
}
