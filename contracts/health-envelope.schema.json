{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://timed-mission-agent.local/contracts/health-envelope.schema.json",
  "title":"Capability Health",
  "type":"object",
  "required":["schema_version","capability_id","lifecycle","readiness","checked_at"],
  "properties":{
    "schema_version":{"const":1},
    "capability_id":{"type":"string","minLength":1},
    "lifecycle":{"enum":["unavailable","starting","healthy","degraded","failed","disabled"]},
    "readiness":{"enum":["installed","configured","authenticated","operational"]},
    "checked_at":{"type":"string","minLength":1},
    "detail_code":{"type":["string","null"]}
  },
  "additionalProperties":false
}
