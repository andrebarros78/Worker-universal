{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timed-mission-agent.local/contracts/qualification-scorecard.schema.json",
  "title": "Qualification Scorecard",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "mode",
    "dataset_id",
    "dataset_version",
    "seed",
    "runs",
    "success_bps",
    "accuracy_bps",
    "validation_bps",
    "p50_ms",
    "p95_ms",
    "p99_ms",
    "recovered_runs",
    "recovery_passed",
    "passed",
    "failures",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["training", "benchmark"]},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "runs": {"type": "integer", "minimum": 1},
    "success_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "accuracy_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "validation_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "p50_ms": {"type": "integer", "minimum": 0},
    "p95_ms": {"type": "integer", "minimum": 0},
    "p99_ms": {"type": "integer", "minimum": 0},
    "recovered_runs": {"type": "integer", "minimum": 0},
    "recovery_passed": {"type": "boolean"},
    "passed": {"type": "boolean"},
    "failures": {"type": "array", "items": {"type": "string"}},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
